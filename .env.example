# Copy to .env and fill in. Do not commit .env.

# Database (required if using Postgres)
# DATABASE_URL=postgresql://user:password@host:port/database

# Telegram control bot
# TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Command to launch the target program (use full path if needed)
# PROGRAM_COMMAND="C:\\Games\\MajesticRP\\launcher.exe"

# Optional command to join a server (e.g. game URI or automation script)
# SERVER_COMMAND="C:\\Games\\MajesticRP\\launcher.exe --server=SanFrancisco"

# Delay before running SERVER_COMMAND after launch/restart (ms)
# SERVER_COMMAND_DELAY_MS=15000
